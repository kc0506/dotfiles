#!/bin/bash
{{- if eq .machine_type "csie" }}
echo ">>> [00] Setting up symlinks to /tmp2..."

# Symlink large directories to /tmp2 to save home directory space.
# run_onchange_before_: must run before chezmoi writes files under these
# paths (e.g. ~/.local/bin), otherwise they land in the real home dir.
# /tmp2 gets wiped periodically; re-running this recreates empty targets.

SYMLINK_BASE="/tmp2/$(whoami)/.symlinks"

mklink() {
    local name="$1"
    local target="$SYMLINK_BASE/$name"
    local link_path="$HOME/$name"

    mkdir -p "$target"
    # Restrict permissions for sensitive directories
    case "$name" in
        .gnupg) chmod 700 "$target" ;;
    esac
    mkdir -p "$(dirname "$link_path")"

    if [ -L "$link_path" ]; then
        rm -f "$link_path"
    elif [ -d "$link_path" ]; then
        # A real dir got created first (e.g. an installer wrote ~/.local/bin
        # before this ran): move its contents into /tmp2, then replace it.
        cp -a "$link_path/." "$target/" && rm -rf "$link_path"
        echo "Migrated existing $link_path into $target"
    elif [ -e "$link_path" ]; then
        echo "ERROR: $link_path already exists and is not a symlink. Please remove it manually."
        exit 1
    fi

    ln -s "$target" "$link_path"
    echo "Created symlink: $link_path -> $target"
}

mklink .gnupg
mklink .cache
mklink .cargo
mklink .rustup
mklink .npm
mklink .npm-global
mklink .mutagen
mklink .nv
mklink .vscode-server
mklink .local/bin
mklink .local/lib
mklink .local/share
mklink miniforge3

# Convenience link
ln -sfn "/tmp2/$(whoami)" "$HOME/tmp2"
{{- end }}
