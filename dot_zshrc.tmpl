del() {
    mkdir -p ~/trash
    mv "$@" ~/trash/
}

{{ if eq .machine_type "wsl" -}}
ivk() {
    local target="${1:-.}"
    if command -v wslpath > /dev/null; then
        target=$(wslpath -w "$target")
    fi
    win pwsh -Command "Invoke-Item '$target'"
}
{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
nosleep() {
  if pmset -g | grep -q "SleepDisabled.*1"; then
    sudo pmset -a disablesleep 0 && echo "☕️ off — 闔蓋會休眠"
  else
    sudo pmset -a disablesleep 1 && echo "🔥 on — 闔蓋不休眠"
  fi
}
{{ end -}}

alias stty='/bin/stty'

alias gdown='uvx gdown'
alias zj=zellij
# Runs the local checkout rather than the npm release, which lags behind fixes
# that only live in the working tree. Rebuilds first (~4s) so it never serves a
# stale dist; the subshell keeps the cd out of the calling shell.
cc-viewer() {
    (cd ~/main/claude-code-viewer && pnpm build && node dist/main.js --port 3400 "$@")
}
# alias vim=nvim

export EDITOR=nvim
export MANPAGER='nvim +Man!'
export LESS="-RsPm-LESS-"

# Path
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/scripts:$PATH"
{{ if eq .machine_type "csie" -}}
export LD_LIBRARY_PATH="$HOME/tmp2/local/lib:$LD_LIBRARY_PATH"
export UV_CACHE_DIR="/tmp2/$(whoami)/.cache/uv"
{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
# GNU coreutils/findutils/sed/grep/awk：讓 rm/cp/mv/ln/ls/find/sed/grep/awk 用 GNU 版，
# 旗標放哪都吃得下（跟 Linux 一致，不再有 BSD「旗標要放最前面」的坑）。
# 只在 macOS 且真的裝了對應 brew 套件時生效；缺哪個就安靜跳過，不污染 PATH。
for _gnubin in coreutils findutils gnu-sed grep gawk; do
    _dir="/opt/homebrew/opt/$_gnubin/libexec/gnubin"
    [ -d "$_dir" ] && export PATH="$_dir:$PATH"
done
[ -d /opt/homebrew/opt/coreutils/libexec/gnuman ] && export MANPATH="/opt/homebrew/opt/coreutils/libexec/gnuman:$MANPATH"
unset _gnubin _dir
[ -d /opt/homebrew/opt/unzip/bin ] && export PATH="/opt/homebrew/opt/unzip/bin:$PATH"
{{ end -}}

# Cargo
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Completions
# 靜態補全檔（_uv/_uvx/_chezmoi/…）放這；compinit 由下面的 oh-my-zsh 跑，
# 所以要 compdef 的動態註冊得等到 omz 之後（見底下的 typer_apps）。
fpath+=~/.zfunc

# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
{{ if eq .machine_type "wsl" -}}
plugins=(git winexec mvd zsh-python-module-completion)
{{ else -}}
plugins=(git zsh-python-module-completion)
{{ end -}}
source $ZSH/oh-my-zsh.sh

{{ if eq .chezmoi.os "darwin" -}}
# oh-my-zsh 的 theme-and-appearance 在 macOS 會設 `alias ls='ls -G'`（BSD 上色旗標）。
# 但我們的 ls 已換成 GNU 版，-G 在 GNU 是「不顯示群組」而非上色 → 顏色會消失。
# 這裡在 omz 之後覆蓋回 GNU 的上色寫法。
alias ls='ls --color=auto'
{{ end -}}

# Typer app 補全。~/.zfunc/_typer_app 是通用的，任何 Typer app 只要把指令名
# 加進這個陣列就有補全，不用跑 `<app> --install-completion`（那會每個 app 存一份
# 補全檔，還會往這個檔案尾巴追加重複的 compinit / zstyle）。
# 補全是即時去執行該 app 問答案，所以每按一次 TAB 就有一次 Python 啟動。
typer_apps=(mednote)
if (( $#typer_apps )); then
    # 這行讓「已 activate venv／app 在 PATH 上」時 `myapp <TAB>` 會補。
    compdef _typer_app $typer_apps
    # 這行讓 `uv run myapp <TAB>` 也會補：補全綁在第一個字上，所以得從 uv 那邊
    # 轉交（見 ~/.zfunc/_uv_typer）。非 Typer app 的情況會原樣退回 uv 自己的補全。
    compdef _uv_typer uv uvx
fi

# Mise
command -v mise &>/dev/null && eval "$(mise activate zsh)"

# Zellij — auto-start on interactive login (not on csie; run `zj` there by hand). Must come *after* mise activation,
# since zellij is installed via mise and isn't on PATH until then.
# Skipped inside VS Code's integrated terminal ($TERM_PROGRAM=vscode): zellij's
# kitty keyboard protocol would otherwise capture VS Code's own shortcuts
# (Ctrl+`, Ctrl+P, …). Run `zj` manually there if you do want zellij.
# (also skipped automatically when already inside a zellij session)
{{ if ne .machine_type "csie" -}}
if [[ "$TERM_PROGRAM" != "vscode" ]]; then
    command -v zellij &>/dev/null && eval "$(zellij setup --generate-auto-start zsh)"
fi
{{ end -}}

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# bun
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"


# Option+Left/Right 跳單字（emacs-like word navigation）
# Ghostty 的 macos-option-as-alt=true 會送出這兩個 CSI 序列
bindkey "\e[1;3D" backward-word   # Option+Left
bindkey "\e[1;3C" forward-word    # Option+Right

# ⌥+Delete：刪一個「shell 字段」。`cli --arg` 一次刪掉 --arg（-. 等標點算字的一部分，
# 不會像預設 backward-kill-word 那樣一段段刪、甚至連 cli 吃掉）；但 `/` 刻意當分隔符，
# 所以 path 是一段一段刪（foo/bar/baz → baz → bar → foo），不會整條爆掉。
backward-kill-space-word() {
  local WORDCHARS='*?_-.[]~=&;!#$%^(){}<>|+@:,'
  zle backward-kill-word
}
zle -N backward-kill-space-word
bindkey "\e\C-?" backward-kill-space-word   # ⌥+Delete
bindkey "\e\C-h" backward-kill-space-word   # ⌥+Backspace

# MAGICK_HOME moved to ~/.zshenv — .zshrc is interactive-only, so scripts and
# agent-run commands never saw it and every vector conversion failed silently.

{{ if eq .machine_type "csie" -}}
# >>> conda initialize >>>
__conda_setup="$("$HOME/miniforge3/bin/conda" 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "$HOME/miniforge3/etc/profile.d/conda.sh" ]; then
        . "$HOME/miniforge3/etc/profile.d/conda.sh"
    else
        export PATH="$HOME/miniforge3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<

# >>> mamba initialize >>>
export MAMBA_EXE="$HOME/miniforge3/bin/mamba"
export MAMBA_ROOT_PREFIX="$HOME/miniforge3"
__mamba_setup="$("$MAMBA_EXE" shell hook --shell zsh --root-prefix "$MAMBA_ROOT_PREFIX" 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__mamba_setup"
else
    alias mamba="$MAMBA_EXE"
fi
unset __mamba_setup
# <<< mamba initialize <<<
{{ end -}}
