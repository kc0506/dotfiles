      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    },
    "ntucool": {
      "source": {
        "source": "github",
        "repo": "kc0506/ntucool"
      }
    }
  },
  "language": "chinese",
