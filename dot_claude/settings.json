{
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "bash -c 'plugin_dir=$(ls -d \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/plugins/cache/claude-hud/claude-hud/*/ 2>/dev/null | awk -F/ '\"'\"'{ print $(NF-1) \"\\t\" $(0) }'\"'\"' | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n | tail -1 | cut -f2-); exec \"/home/kc0506/.local/share/mise/installs/node/latest/bin/node\" \"${plugin_dir}dist/index.js\"'"
  },
  "cleanupPeriodDays": 36500,
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "claude-hud@claude-hud": true,
    "skill-creator@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "ntucool@ntucool": true
  },
  "extraKnownMarketplaces": {
